XR7_ENV=production
DATABASE_URL=postgresql+psycopg://xr7:replace@postgres.example:5432/xr7
REDIS_URL=redis://redis.example:6379/0
CELERY_BROKER_URL=redis://redis.example:6379/0
CELERY_RESULT_BACKEND=redis://redis.example:6379/1
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=replace
S3_SECRET_ACCESS_KEY=replace
S3_BUCKET=xr7-artifacts
S3_USE_SSL=1
WIDGET_ALLOWED_ORIGINS=https://app.xr7.example.com
XR7_EVIDENCE_SIGNING_MODE=rsa
XR7_EVIDENCE_PRIVATE_KEY_PEM=replace
XR7_EVIDENCE_PUBLIC_KEY_PEM=replace
TROLLEY_SECRET_KEY=replace
PLUGIN_SIGNATURE_SECRET=replace
