# Caddy production config for ArtistOS.
# Two sites:
#   {$API_DOMAIN}  → reverse proxy to the FastAPI app container
#   {$APP_DOMAIN}  → static SPA (Vite-built dist mounted at /srv/app)
# Caddy auto-issues Let's Encrypt TLS for both on first request.

{$API_DOMAIN:localhost} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# CORS handled in FastAPI — do not double it here
		-Server
	}

	reverse_proxy api:8000 {
		health_uri /health
		health_interval 30s
		health_timeout 5s
	}
}

{$APP_DOMAIN:localhost} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Cache strategy — so a new deploy is picked up WITHOUT a hard refresh.
	#
	# Vite content-hashes everything under /assets/ (index-AbC123.js); the
	# filename changes on every build, so a stale one is impossible — cache
	# those forever.
	#
	# Everything else (index.html, the logo, favicon) must revalidate on
	# every visit. index.html is the lynchpin: it names the current hashed
	# asset files, so as long as it is never served stale a returning
	# visitor always boots the latest build. "no-cache" means "cache but
	# revalidate first" — the ETag turns that into a cheap 304 when nothing
	# changed, so it is not a full re-download every visit.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@unhashed not path /assets/*
	header @unhashed Cache-Control "no-cache"

	root * /srv/app
	# SPA routing: any path that isn't a real file returns index.html
	# so the React router handles it client-side.
	try_files {path} /index.html
	file_server
}
