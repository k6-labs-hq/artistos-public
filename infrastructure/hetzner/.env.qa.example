# ArtistOS QA environment — Hetzner.
# Copy to .env.qa on the QA VM and fill in real values. Do NOT commit.
# QA may use test credentials. NEVER put real artist data in QA.

# ─── Environment ──────────────────────────────────────────────
XR7_ENV=qa
DOMAIN=api.qa.xr7.k6-labs.com

# ─── Database (Hetzner Managed Postgres) ──────────────────────
# Connection string from Hetzner console → Managed DB → Connection
DATABASE_URL=postgresql+psycopg://xr7:CHANGE_ME@<hetzner-postgres-host>:5432/xr7

# ─── Redis (in-compose or external) ───────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── Object Storage (Hetzner Object Storage, S3-compatible) ───
# From Hetzner console → Object Storage → Security → Credentials
S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=xr7-artifacts-qa
S3_USE_SSL=1

# ─── XR7 JWT signing (used after Supabase exchange) ───────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
XR7_JWT_SECRET=CHANGE_ME_TO_48_BYTE_RANDOM
XR7_JWT_ISSUER=xr7-engine
XR7_JWT_AUDIENCE=xr7-clients
XR7_JWT_ACCESS_TTL_MINUTES=60
XR7_ENFORCE_AUTH_GLOBALLY=1

# ─── Supabase Auth ────────────────────────────────────────────
# From Supabase console → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=CHANGE_ME
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# ─── Trolley (payouts) ────────────────────────────────────────
TROLLEY_API_KEY=CHANGE_ME
TROLLEY_API_SECRET=CHANGE_ME
TROLLEY_ENVIRONMENT=sandbox

# ─── LLM provider ─────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=CHANGE_ME

# ─── Observability ────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Admin seed (first-run only, retire via Supabase admin role) ──
XR7_ADMIN_EMAIL=
XR7_ADMIN_PASSWORD=

# ─── Evidence signing ─────────────────────────────────────────
XR7_EVIDENCE_SIGNING_MODE=hmac
XR7_EVIDENCE_HMAC_SECRET=CHANGE_ME_TO_48_BYTE_RANDOM

# ─── Tenant isolation ─────────────────────────────────────────
XR7_DEFAULT_TENANT_ID=default
