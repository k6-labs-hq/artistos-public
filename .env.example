# XR7 Engine 2 — Environment Variables
# =========================================
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your credentials
#   source .env && uvicorn XR7.api.app:app --reload

# ─── Application Environment ───────────────────────────────────────────────
# Set to "production" to:
#   • Enable real SMS/email delivery (requires Twilio + SMTP config below)
#   • Disable mock OTPs in widget API responses
#   • Prevent MockNotificationService from being instantiated
XR7_ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
XR7_LOG_LEVEL=INFO

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite (default — suitable for development only)
DATABASE_URL=sqlite:///./XR7.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/XR7

# Database connection pool settings (PostgreSQL only)
XR7_DB_POOL_SIZE=10
XR7_DB_MAX_OVERFLOW=20
XR7_DB_POOL_TIMEOUT=30
XR7_DB_POOL_RECYCLE=1800

# ─── Queue + Cache (Redis/Celery) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
XR7_SYNC_QUEUE_MODE=celery
XR7_SYNC_REQUEUE_SECONDS=60
LANGGRAPH_CHECKPOINTER_URL=redis://localhost:6379/2
# LLM Configuration (for AI-powered features: gap explainer, claim drafting, catalog auditing)
# Provider: openai | xai (for xAI/Grok models)
LLM_PROVIDER=openai
# Model name: gpt-4o-mini | gpt-4o | grok-beta
LLM_MODEL=gpt-4o-mini
# API key for OpenAI or X.AI (required for LLM features to work)
LLM_API_KEY=

# Parser plugin sandbox + signature policy
XR7_PLUGIN_ALLOWED_PREFIXES=XR7.plugins,tests.plugins
XR7_PLUGIN_BLOCKED_PREFIXES=os,sys,subprocess,builtins,importlib
# Optional: when set, plugin signatures are required and validated using HMAC-SHA256(entrypoint)
XR7_PLUGIN_SIGNATURE_SECRET=

# ─── Object Storage (MinIO / S3 compatible) ───────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=xr7-artifacts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false

# ─── Widget Admin Access ────────────────────────────────────────────────────
# Secret key for the GET /widget/leads admin endpoint.
# Must be a long
# Alternative admin secret key (fallback for admin operations)
ADMIN_SECRET_KEY=, random string. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank to disable the admin endpoint entirely.
WIDGET_ADMIN_KEY=
ADMIN_API_KEY=
ANALYST_API_KEY=

# ─── CORS — Widget Allowed Origins ─────────────────────────────────────────
# Comma-separated list of origins permitted to embed the widget.
# REQUIRED when XR7_ENV=production — using '*' in production is blocked.
# Example: WIDGET_ALLOWED_ORIGINS=https://yourlabel.com,https://partner.com
# Leave as '*' for development (allows any origin).
WIDGET_ALLOWED_ORIGINS=*

# ─── Twilio SMS (required when XR7_ENV=production) ───────────────────────
# Sign up at https://www.twilio.com/
# Your Account SID is on the Twilio console dashboard.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The phone number to send SMS from (must be a Twilio number, E.164 format)
TWILIO_FROM_NUMBER=+15550000000

# ─── SMTP Email (required when XR7_ENV=production) ───────────────────────
# Works with any SMTP provider: SendGrid, AWS SES, Mailgun, Gmail, etc.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=noreply@

# Email unsubscribe URL (used in email templates)
XR7_UNSUBSCRIBE_URL=https://xr7.com/unsubscribeyourdomain.com
# Set to "true" to use SSL on port 465 instead of STARTTLS on port 587
SMTP_USE_SSL=false

# ─── HubSpot CRM Integration ──────────────────────────────────────────────
HUBSPOT_ENABLED=false
HUBSPOT_BASE_URL=https://api.hubapi.com
# Use one of the following auth methods:
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_API_KEY=

# ─── Partner Ecosystem Connectors ─────────────────────────────────────────
# Configure provider credentials/base URLs for /artists/{id}/connect/{provider}
STRIPE_CONNECT_TOKEN=
STRIPE_CONNECT_BASE_URL=

CHARTMETRIC_TOKEN=
CHARTMETRIC_BASE_URL=

SONGTRUST_TOKEN=
SONGTRUST_BASE_URL=

TUNECORE_TOKEN=
TUNECORE_BASE_URL=

DISTROKID_TOKEN=
DISTROKID_BASE_URL=

ASCAP_TOKEN=
ASCAP_BASE_URL=

BMI_TOKEN=
BMI_BASE_URL=

SESAC_TOKEN=
SESAC_BASE_URL=

# ─── OAuth Providers (DSP/Social) ────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_CLIENT_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

SOUNDCLOUD_CLIENT_ID

# UGC Platform API Keys (for usage monitoring)
YOUTUBE_API_KEY=
TIKTOK_API_KEY=

# MLC (Mechanical Licensing Collective) Integration
MLC_API_KEY=
MLC_API_BASE_URL=https://api.themlc.com=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_TOKEN=
SOUNDCLOUD_BASE_URL=

# ─── JWT Auth (Artist/Admin) ───────────────────────────────────────────────
XR7_JWT_SECRET=change-me-in-production
XR7_JWT_ISSUER=xr7-engine
XR7_JWT_AUDIENCE=xr7-clients
XR7_JWT_ACCESS_TTL_MINUTES=60
XR7_ADMIN_EMAIL=admin@xr7.local
XR7_ADMIN_PASSWORD=change-me
# Set to 1 to make soft-guarded endpoints (earnings, anomalies, claims list) require auth too.
XR7_ENFORCE_AUTH_GLOBALLY=0

# ─── Payment Processing (Trolley) ─────────────────────────────────────────
# Trolley API credentials for disbursements (required for production payments)
TROLLEY_ACCESS_KEY=
TROLLEY_SECRET_KEY=

# ─── Evidence Cryptographic Signing ──────────────────────────────────────
# Evidence signing mode: "hmac" (default) or "rsa" (production recommended)
XR7_EVIDENCE_SIGNING_MODE=hmac

# HMAC-SHA256 secret for evidence chain-of-custody (default mode)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
XR7_EVIDENCE_HMAC_SECRET=xr7-dev-evidence-secret

# RSA key pair for evidence signing (production mode)
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Then set the full PEM content (including BEGIN/END lines) as environment variables
XR7_EVIDENCE_PRIVATE_KEY_PEM=
XR7_EVIDENCE_PUBLIC_KEY_PEM=

# ─── Encrypted Vault  ──────────────────────────────────────────────────────
# Master encryption key for sensitive data in vault (API keys, credentials)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
XR7_VAULT_MASTER_KEY=xr7-dev-vault-key-change-me

# ─── Security & Virus Scanning ────────────────────────────────────────────
# ClamAV antivirus scanning for uploaded files
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ─── Agent & AI Features ───────────────────────────────────────────────────
# Onboarding agent readiness threshold (0-100, default 85)
XR7_ONBOARDING_READINESS_THRESHOLD=85

# AI music influence detection (set to "0" to use real API instead of simulation)
XR7_AI_MUSIC_SIMULATED=1

# ─── Review Queue Alerts ───────────────────────────────────────────────────
# Alert threshold for review queue size (triggers notifications)
REVIEW_QUEUE_ALERT_THRESHOLD=25

# ─── VIP & Invite System ───────────────────────────────────────────────────
# Base URL for VIP invite links (used in referral emails)
INVITE_BASE_URL=https://app.xr7.io/onboard

# ─── Multi-Tenancy & White-Label ──────────────────────────────────────────
# Enable white-label branding features (set to "1" to enable)
XR7_WHITE_LABEL_ENABLED=0

# Data residency enforcement (comma-separated ISO country codes, e.g., "US,CA,GB")
XR7_DATA_RESIDENCY_ENABLED=

# ─── Frontend Runtime ──────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_ARTIST_TOKEN=
