# Frontend environment — copy to .env (dev) or set at build time (prod).
# Variables prefixed with VITE_ are exposed to the browser bundle.

# API base URL
# Dev: http://localhost:8000
# Prod: https://api.your-domain.com
VITE_API_BASE_URL=http://localhost:8000

# Supabase Auth — public (anon) key. Safe to expose to the browser.
# From Supabase console → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry (optional, public DSN is safe to expose).
# Leave VITE_SENTRY_DSN blank to ship a bundle without Sentry — the
# init block tree-shakes out. VITE_SENTRY_ENVIRONMENT tags events
# (qa / production / etc.) so a single Sentry project can host
# multiple deploys.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
